# Anthropic API Key for LLM-based research and critique
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Postgres and MinIO credentials for this install.
# This repo is public — set your own values here rather than relying on the
# in-code defaults (researchpass / minio / miniopass). Copy this file to .env
# (already gitignored) and fill these in before running docker-compose up.
POSTGRES_PASSWORD=change_me
MINIO_ROOT_USER=change_me
MINIO_ROOT_PASSWORD=change_me
